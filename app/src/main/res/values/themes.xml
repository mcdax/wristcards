<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Swiping back is a system gesture. Without enableOnBackInvokedCallback (manifest), Wear OS ends
         the activity directly instead of sending a back event: then neither "Confirm exit" nor the
         navigation applies. With the flag, the swipe arrives in the app as a normal back. -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault">
    </style>

    <!-- Launch theme: the system splash stays up until the collection is open (MainActivity),
         so there is only one icon on screen during start instead of two at different sizes. -->
    <style name="AppTheme.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>
</resources>
